# ==============================================================================
# AI Model API Keys Template (Copy to .env)
# ==============================================================================

# Google AI Studio (Gemini 2.5 / 3.7 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter Free Models (GLM 5.2 / Nemotron 3 Super / DeepSeek)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq Cloud (Ultra-Fast Inference / Llama 3.3 / GPT-OSS)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Default Model Configuration
DEFAULT_LLM_MODEL=gemini-2.5-flash
DEFAULT_LLM_TEMPERATURE=0.7

# FastAPI token verification: use the signing key of the trusted token issuer.
# Never use a public/example key. Empty disables token verification (fails closed).
SECRET_KEY=
# Optional FastAPI database credentials; no password is supplied by the application.
DB_PASSWORD=

# Planning recovery and attendance reporting (production requires Redis and PostgreSQL).
TIMETABLE_GLOBAL_REQUESTS_PER_MINUTE=10
TIMETABLE_MAX_ATTEMPTS=3
TIMETABLE_RETRY_BASE_SECONDS=15
TIMETABLE_DISPATCH_SECONDS=15
ATTENDANCE_RECONCILE_SECONDS=30
ATTENDANCE_HISTORY_PAGE_SIZE=100
SQLITE_BUSY_TIMEOUT_SECONDS=20

# Saved lecture note translation (original-language notes never invoke an LLM).
NOTES_TRANSLATION_MODEL=gemini-2.5-flash-lite
NOTES_TRANSLATION_MAX_CHARACTERS=12000
NOTES_TRANSLATION_MAX_TOKENS=4096
NOTES_TRANSLATION_LEASE_SECONDS=180
NOTES_TRANSLATION_REQUEST_RATE=3/min
# CLASSROOM_MEDIA_ROOT=/absolute/private/lecture-media

# Bounded student-answer evaluation
LESSON_EVALUATION_MODEL=gemini-2.5-flash-lite
LESSON_EVALUATION_MAX_TOKENS=1024
LESSON_EVALUATION_LEASE_SECONDS=180

# Offline local-development speech (macOS say / Docker espeak-ng; English)
CLASSROOM_TTS_TIMEOUT_SECONDS=15
CLASSROOM_TTS_MAX_CHARACTERS=4000
CLASSROOM_TTS_REQUEST_RATE=30/min

# Shared cache and bounded background lesson preparation
CLASSROOM_SHARED_CACHE=true
CLASSROOM_MAX_PENDING_JOBS=200
CLASSROOM_USER_PENDING_JOBS=2
CLASSROOM_MAX_RUNNING_JOBS=2
CLASSROOM_REQUESTS_PER_MINUTE=10
CLASSROOM_SUBMISSION_RATE=6/min
CLASSROOM_JOB_TIMEOUT_SECONDS=600
CLASSROOM_JOB_MAX_ATTEMPTS=3
CLASSROOM_RETRY_SECONDS=15
CLASSROOM_BREAKER_FAILURES=3
CLASSROOM_BREAKER_SECONDS=30
