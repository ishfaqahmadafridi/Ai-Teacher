# ─────────────────────────────────────────────────────────────────────────────
# AI Teacher — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret-key

# "True" for local development, "False" for staging and production
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames
# Development:  localhost,127.0.0.1
# Production:   yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave empty in development (CORS_ALLOW_ALL_ORIGINS=True is used automatically
# when DJANGO_DEBUG=True and this value is empty).
# Production example: https://ai-teacher.yourdomain.com
CORS_ALLOWED_ORIGINS=

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ai_teacher_db
DB_USER=ai_teacher_user
DB_PASSWORD=ai_teacher_secret_pass
DB_HOST=localhost
DB_PORT=5432

# ── Redis Cache & Async Broker ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
